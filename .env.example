# Copy this file to .env and fill in real values. .env should never be committed.

# Your work/office address, used as the commute origin.
OFFICE_ADDRESS="123 Example St, Sydney NSW 2000"

# Optional: point saved_webpages capture at a shared cloud-synced folder
# instead of the repo-local default, if more than one person is capturing
# listings. Leave unset to use ./saved_webpages.
SAVED_WEBPAGES_DIR=""

# Google Cloud API key with the Geocoding API and Routes API enabled.
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=""

# Shared Google Sheet (sheets/publish.py, sheets/sync_back.py) -- see
# README "Shared Google Sheet" for the one-time setup. Optional: the rest
# of the pipeline works fine without these set.
GOOGLE_SHEETS_KEY_PATH=""
GOOGLE_SHEET_ID=""
